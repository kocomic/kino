# Must be an absolute host path. The container mounts it read-only.
ROM_LIBRARY_PATH=/absolute/path/to/rom-library

# Optional prebuilt image override. The default builds and tags the current
# source tree as kino:0.1.0-preview.5.
# KINO_IMAGE=registry.example/kino:0.1.0-preview.5

# Generate with: openssl rand -hex 32
GAME_LIBRARY_TOKEN=replace-with-a-long-random-secret

KINO_BIND=0.0.0.0
KINO_PORT=8080
TZ=Asia/Shanghai

# Optional browser player. For a local pinned data/ directory, set the absolute
# container path and a read-only mount. Leave it unset to disable browser play.

# Alternative for resources already hosted by a reverse proxy or fixed HTTPS

